# RK3588 EVB7 AP6398S WiFi/BT
# AP6XXX=m -> bcmdhd built as loadable module (dhd), loaded post-boot AFTER
# rfkill-wlan deferred-probe completes -> gets valid WL_REG_ON GPIO (fixes race).
CONFIG_WL_ROCKCHIP=y
CONFIG_BCMDHD=y
CONFIG_AP6XXX=m
CONFIG_BCMDHD_SDIO=y
# CONFIG_WIFI_LOAD_DRIVER_WHEN_KERNEL_BOOTUP is not set
# CONFIG_WIFI_BUILD_MODULE is not set
